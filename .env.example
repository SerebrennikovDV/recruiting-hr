# =============================================================================
# Конфигурация UnitHire для Yandex Cloud (Compute VM + PostgreSQL в Docker)
# =============================================================================
# Скопировать в .env, заполнить реальные значения, выполнить chmod 600 .env.

# --- Django -----------------------------------------------------------------
# Сгенерировать секрет: openssl rand -hex 32
DJANGO_SECRET_KEY=замените-на-случайный-секрет-минимум-50-символов
DJANGO_DEBUG=False

# Публичный IP VM или домен (несколько хостов через запятую).
DJANGO_ALLOWED_HOSTS=93.77.185.176

# Доверенные origin для CSRF — обязательно с указанием схемы http/https.
DJANGO_CSRF_TRUSTED=http://93.77.185.176

# Использовать HTTPS-настройки cookie (Secure + HSTS). Для IP без TLS = False.
DJANGO_USE_HTTPS=False

# --- База данных ------------------------------------------------------------
# Вариант 1 (по умолчанию): PostgreSQL в Docker, сервис "db" в той же
# docker-compose.yml. Пароль из POSTGRES_PASSWORD ниже должен совпадать.
DATABASE_URL=postgresql://unithire:ChangeMeStrong2026@db:5432/unithire

# Пароли для контейнера postgres:15-alpine.
POSTGRES_DB=unithire
POSTGRES_USER=unithire
POSTGRES_PASSWORD=ChangeMeStrong2026

# Вариант 2 (опционально): Managed Service for PostgreSQL в Yandex Cloud.
# Закомментируй DATABASE_URL выше и раскомментируй строки ниже,
# подставив FQDN-host из UI кластера Managed PG:
# DATABASE_URL=postgresql://unithire:CHANGE_ME@rc1a-XXXXXX.mdb.yandexcloud.net:6432/unithire?sslmode=require
# DB_SSL_REQUIRE=False

# --- Подсистема интеграции с внешними площадками подбора ---------------
# 1 - работа на сохранённых ответах площадок (по умолчанию),
# 0 - обращение к промышленным интерфейсам.
CONNECTORS_MOCK_MODE=1
# Ключи площадок. hh.ru для поиска вакансий ключа не требует.
SUPERJOB_SECRET=
AVITO_TOKEN=

# --- Подсистема первичного отбора резюме -------------------------------
# Пороговые значения оценки соответствия, баллы от 0 до 100.
SCREENING_AUTO_REJECT=50
SCREENING_RECOMMEND=70
