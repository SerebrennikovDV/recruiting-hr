# Пример файла переменных окружения. Скопируйте в .env и заполните значения.
# Файл .env в репозиторий не коммитится (см. .gitignore).

# Секретный ключ Django (сгенерируйте собственный для продакшена)
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret

# Режим отладки: True для локальной разработки, False для продакшена
DJANGO_DEBUG=True

# Разрешённые хосты (через запятую), помимо localhost
DJANGO_ALLOWED_HOSTS=

# Подключение к базе данных.
# Локально (по умолчанию) используется SQLite — переменную можно не задавать.
# Для PostgreSQL укажите строку подключения, например:
# DATABASE_URL=postgres://user:password@localhost:5432/unithire
DATABASE_URL=
