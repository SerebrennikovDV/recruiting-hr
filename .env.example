# =============================================================================
# Конфигурация UnitHire для Yandex Cloud (Compute VM + Managed PostgreSQL)
# =============================================================================
# Скопировать в .env, заполнить реальные значения, выполнить `chmod 600 .env`.

# --- Django -----------------------------------------------------------------
# Сгенерировать секрет:  openssl rand -hex 32
DJANGO_SECRET_KEY=замените-на-случайный-секрет-минимум-50-символов
DJANGO_DEBUG=False

# Публичный IP VM (или несколько хостов через запятую).
DJANGO_ALLOWED_HOSTS=111.88.244.202

# Доверенные origin для CSRF — обязательно с указанием схемы.
DJANGO_CSRF_TRUSTED=http://111.88.244.202

# Использовать HTTPS-настройки cookie (Secure + HSTS). Для IP без TLS = False.
DJANGO_USE_HTTPS=False

# --- База данных ------------------------------------------------------------
# Managed PostgreSQL в Yandex Cloud. Формат:
#   postgresql://USER:PASSWORD@FQDN-host:6432/DBNAME?sslmode=verify-full
# FQDN-host берётся из UI кластера Managed PostgreSQL.
# Если возникает проблема с verify-full — заменить на sslmode=require.
DATABASE_URL=postgresql://unithire:CHANGE_ME@rc1a-XXXXXX.mdb.yandexcloud.net:6432/unithire?sslmode=require

# True — если хочешь явное требование SSL поверх настроек URL.
DB_SSL_REQUIRE=False
